{
  "name": "auriportal-server",
  "version": "5.82.6",
  "description": "Portal de Aurelín - Sistema de gestión de estudiantes y rachas de práctica (Servidor Node.js)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "npx tailwindcss -i ./src/css/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "npx tailwindcss -i ./src/css/input.css -o ./public/css/tailwind.css --watch",
    "pm2:start": "pm2 start server.js --name aurelinportal",
    "pm2:stop": "pm2 stop aurelinportal",
    "pm2:restart": "pm2 restart aurelinportal",
    "pm2:logs": "pm2 logs aurelinportal",
    "transcripcion:forzar-todos": "node scripts/forzar-transcripcion-todos.js",
    "verificar-v4": "node scripts/verificar-v4.js",
    "audit:no-sqlite": "node scripts/audit-no-sqlite.js",
    "verify:levels": "node scripts/verify-level-engine-db.js && node scripts/verify-level-engine-sample.js",
    "verify:level-gates": "node scripts/verify-level-gates-db.js && node scripts/verify-level-gates-sample.js",
    "verify:cleaning-engine": "node scripts/verify-cleaning-engine-db.js && node scripts/verify-cleaning-engine-sample.js",
    "verify:cleaning-engine-pde": "node scripts/verify-cleaning-engine-pde.js",
    "verify:cleaning-engine-canonical": "node scripts/verify-cleaning-engine-canonical-v1.js",
    "verify:alquimia-archived": "node scripts/verify-alquimia-archived-items.js",
    "check:god-ui": "node scripts/check-god-ui-assembly.js",
    "check:http-contract": "node scripts/check-http-contract.js",
    "check:student-identity": "node scripts/check-student-identity-contract.js",
    "check:signals-registry": "node scripts/check-signals-registry.js",
    "check:view-authority": "node scripts/check-view-authority.js",
    "check:lpm-pdui": "node scripts/check-lpm-pdui.js",
    "check:ux-refresh": "node scripts/check-ux-refresh-wiring.js",
    "check:ux-action-registry": "node scripts/check-ux-action-registry.js",
    "check:forbid-legacy-reset-delete": "node scripts/check-forbid-legacy-reset-delete.js",
    "check:action-registry-parity": "node scripts/check-action-registry-parity.js",
    "check:no-legacy-reset-overrides-ui": "node scripts/check-no-legacy-reset-overrides-ui.js",
    "check:runtime-core": "node scripts/check-runtime-core-assembly.js",
    "check:master-constitution": "npm run check:view-authority && npm run check:lpm-pdui",
    "check:all": "npm run check:god-ui && npm run check:http-contract && npm run check:student-identity && npm run check:signals-registry && npm run check:view-authority",
    "test:alquimia-ui": "node scripts/test-alquimia-ui-critical.js",
    "test:alquimia-una-vez": "node scripts/test-alquimia-una-vez.js",
    "test:contrato-limpieza": "node scripts/test-contrato-limpieza-v1.js",
    "test:alquimia-smoke": "node scripts/test-alquimia-smoke.js",
    "smoke:master-alquimia": "node scripts/smoke-master-alquimia-general.js",
    "mcp:google-workspace": "node mcp-server/google-workspace.js",
    "mcp:test": "node mcp-server/test-connection.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --maxWorkers=2"
  },
  "keywords": [
    "nodejs",
    "clickup",
    "kajabi",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@simonwep/pickr": "^1.9.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "busboy": "^1.6.0",
    "dotenv": "^16.6.1",
    "googleapis": "^144.0.0",
    "mailgun.js": "^11.0.0",
    "music-metadata": "^11.10.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.11",
    "pg": "^8.11.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "pm2": "^5.4.3",
    "tailwindcss": "^3.4.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
